# Store LF in the repository whatever the contributor's platform does locally.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.ico binary

# Fixtures are the test suite, not documentation or vendored code — keep them
# in the language statistics and in diffs.
testdata/** linguist-detectable=true

# The CRLF fixtures ARE the line-ending regression test. Normalising them to
# LF at commit time would delete the case they exist to catch.
testdata/clean/crlf/** -text
testdata/vulnerable/crlf/** -text

docs/*.png linguist-documentation=true
